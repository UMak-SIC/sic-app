# Neon pooled PostgreSQL connection string. Keep this server-only; never use
# a NEXT_PUBLIC_ prefix or commit a real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# IANA timezone used for organization-local event display and provider quota days.
ORGANIZATION_TIMEZONE="Asia/Manila"

# Dedicated secret for cron-job.org. Generate a unique high-entropy value with
# `openssl rand -base64 32`; send it in the X-Cron-Secret header every 5 minutes.
CRON_SECRET="replace-with-a-unique-cron-secret"

# Neon Managed Better Auth configuration. The base URL is provisioned by Neon;
# generate the cookie secret with `openssl rand -base64 32`.
NEON_AUTH_BASE_URL="https://auth.example.neon.tech/neon_auth"
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-32-character-secret"

# After creating the administrator through Neon Auth, provide that user's ID to
# the one-time allowlisting script. Keep this server-only.
ADMIN_NEON_AUTH_USER_ID="replace-with-a-neon-auth-user-id"

# High-entropy secret required by the scheduled five-year retention cleanup.
RETENTION_CRON_SECRET="replace-with-a-high-entropy-secret"

# Neon Object Storage injects these values into Neon Functions. For this Vercel
# app, pull them locally with `neon env pull` and configure the matching values
# in each Vercel environment. Never use a NEXT_PUBLIC_ prefix.
AWS_ACCESS_KEY_ID="replace-with-neon-storage-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-neon-storage-secret-access-key"
AWS_ENDPOINT_URL_S3="https://branch-id.storage.region.neon.tech"
AWS_REGION="ap-southeast-1"

# Shared secret required by the internal queue-worker endpoint. Generate it with
# `openssl rand -base64 32`; do not expose it with a NEXT_PUBLIC_ prefix.
QUEUE_WORKER_SECRET="replace-with-a-random-32-character-secret"

# Secret used to HMAC-sign opaque QR tickets. This value is the trust boundary
# for check-in: a ticket that does not verify under it will not scan, and this
# release has no way to reissue one.
#
# Generate it with `openssl rand -base64 32` and keep at least 32 characters.
# Give every environment its own value; never copy one environment's secret
# into another.
#
# Rotating invalidates every ticket already sent. Only rotate when no event's
# check-in window is still open, and follow the runbook, which covers the
# pre-rotation check, the recovery path if you rotate by accident, and key
# hygiene: docs/qr-ticket-secret-rotation.md
QR_TICKET_SECRET="replace-with-a-random-32-character-secret"

# Email delivery uses Brevo over HTTPS from the queue worker; no SMTP relay runs
# in this app. `BREVO_FROM_EMAIL` and `BREVO_FROM_NAME` are separate because the
# Brevo API takes them as a structured sender.
BREVO_API_KEY="replace-with-your-brevo-api-key"
BREVO_FROM_EMAIL="events@example.com"
BREVO_FROM_NAME="UMak SIC"

# Daily send allowance, enforced by transactional reservation. The quota day is
# the organization's own
# calendar day, so it resets at local midnight per ORGANIZATION_TIMEZONE rather
# than at 00:00 UTC.
#
# Setting this to 0 stops sending without a code change; a malformed value falls
# back to the default rather than failing the day's delivery.
BREVO_DAILY_LIMIT="300"
