# Use a dedicated Neon branch for integration tests. Never point this at dev,
# staging, or production: the Vitest setup truncates application tables.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-test-branch.example.neon.tech/neondb?sslmode=require"

# Test-only secret for signing QR tickets. Must be at least 32 characters and
# must never match the production QR_TICKET_SECRET.
QR_TICKET_SECRET="replace-with-a-test-only-32-character-secret"

# Provider keys are not needed for tests: the adapters take their transport and
# environment by injection, so the suites stub `fetch` and pass an env object
# rather than reading these. Listed so it is clear the absence is deliberate
# rather than an oversight.
#
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN=""
# MAILGUN_FROM=""
# BREVO_API_KEY=""
# BREVO_FROM_EMAIL=""
# BREVO_FROM_NAME=""
